<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Code en bulles</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #eef2ff, #dbeafe);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .app {
      background: white;
      padding: 32px;
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
      width: min(90vw, 420px);
      text-align: center;
    }

    h1 {
      margin-top: 0;
      font-size: 1.8rem;
      color: #1e3a8a;
    }

    p {
      color: #475569;
      margin-bottom: 20px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      font-size: 1.2rem;
      border: 2px solid #cbd5e1;
      border-radius: 14px;
      outline: none;
      text-align: center;
      letter-spacing: 4px;
    }

    input:focus {
      border-color: #3b82f6;
    }

    .bubbles {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 24px;
      flex-wrap: wrap;
      min-height: 60px;
    }

    .bubble {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #3b82f6;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      font-weight: bold;
      box-shadow: 0 8px 18px rgba(59, 130, 246, 0.35);
      animation: pop 0.2s ease;
    }

    .placeholder {
      color: #94a3b8;
      font-size: 0.95rem;
      margin-top: 8px;
    }

    @keyframes pop {
      0% {
        transform: scale(0.6);
        opacity: 0;
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .actions {
      margin-top: 20px;
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    button {
      border: none;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 1rem;
      cursor: pointer;
    }

    .primary {
      background: #2563eb;
      color: white;
    }

    .secondary {
      background: #e2e8f0;
      color: #1e293b;
    }
  </style>
</head>
<body>
  <div class="app">
    <h1>Code en bulles</h1>
    <p>Entre un code numérique ci-dessous</p>

    <input
      id="codeInput"
      type="text"
      inputmode="numeric"
      maxlength="8"
      placeholder="Ex: 1234"
    />

    <div id="bubbles" class="bubbles"></div>
    <div class="placeholder">Chaque chiffre apparaît dans une bulle</div>

    <div class="actions">
      <button class="primary" onclick="validerCode()">Valider</button>
      <button class="secondary" onclick="viderCode()">Effacer</button>
    </div>
  </div>

  <script>
    const input = document.getElementById("codeInput");
    const bubbles = document.getElementById("bubbles");

    function renderBubbles(value) {
      const chiffres = value.replace(/\D/g, "");
      input.value = chiffres;
      bubbles.innerHTML = "";

      for (const chiffre of chiffres) {
        const bubble = document.createElement("div");
        bubble.className = "bubble";
        bubble.textContent = chiffre;
        bubbles.appendChild(bubble);
      }
    }

    function validerCode() {
      const code = input.value;
      if (!code) {
        alert("Veuillez entrer un code.");
        return;
      }
      alert("Code saisi : " + code);
    }

    function viderCode() {
      input.value = "";
      bubbles.innerHTML = "";
      input.focus();
    }

    input.addEventListener("input", (e) => {
      renderBubbles(e.target.value);
    });
  </script>
</body>
</html>